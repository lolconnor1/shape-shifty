  m_Script: {fileID: 11500000, guid: ed6278055cdb5e842a597a9f83d025ef, type: 3}
  m_Name: Level01_Rat_Keeper
  m_EditorClassIdentifier: 
  lines:
  - byPlayer: 0
    text: Psst! Haven't seen you round the bins before.
  - byPlayer: 1
    text: I'm... new here.
  - byPlayer: 0
    text: Here's a tip, newbie. The keeper never looks twice at a rat. Walk right
      under his nose if you like.
  - byPlayer: 0
    text: Just don't go turning into something else while he's watching. Nothing
      spooks a human faster.
