  m_Script: {fileID: 11500000, guid: ed6278055cdb5e842a597a9f83d025ef, type: 3}
  m_Name: Level04_Lookout
  m_EditorClassIdentifier: 
  lines:
  - byPlayer: 0
    text: Guerillas up ahead, past the logs. Lots of them. Past the ruins there's
      their village, and they hide up in the trees there. Then the gorge. Then the
      King.
  - byPlayer: 0
    text: Me? I'm on lookout. Very important job. Staying right here.
