  m_Script: {fileID: 11500000, guid: ed6278055cdb5e842a597a9f83d025ef, type: 3}
  m_Name: Level1_Rat_Aisles
  m_EditorClassIdentifier: 
  lines:
  - byPlayer: 0
    text: Whoa, a fresh face! Came up the vent from the yard, did ya?
  - byPlayer: 0
    text: The drain's right at the back of the building. Three rooms that way.
  - byPlayer: 0
    text: First you need the shutter by the loading dock sign open, and its lever
      needs hands.
  - byPlayer: 0
    text: Watch the guard pacing these aisles. Find a quiet corner before you go
      sprouting legs. The crates by the shutter make a good hidey-hole.
  - byPlayer: 1
    text: Thanks! I'll keep my head down.
