  m_Script: {fileID: 11500000, guid: ed6278055cdb5e842a597a9f83d025ef, type: 3}
  m_Name: Level01_Rat_Abilities
  m_EditorClassIdentifier: 
  lines:
  - byPlayer: 0
    text: Oi, mind the crumbs! Oh... you're one of us.
  - byPlayer: 0
    text: First day as a rat? Sprint and nobody round here can catch you.
  - byPlayer: 0
    text: And being small is a gift. Duck behind something low and the big folk can't
      see you at all.
  - byPlayer: 1
    text: Good to know. Thanks!
  - byPlayer: 0
    text: Squeak.
