  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed6278055cdb5e842a597a9f83d025ef, type: 3}
  m_Name: Level02_Penguin_Abilities
  m_EditorClassIdentifier: 
  lines:
  - byPlayer: 0
    text: Ooh, a new one! Nice waddle. Very convincing.
  - byPlayer: 0
    text: Crouch and you'll flop onto your belly. Snow's slow, but the ice slide...
      whoosh!
  - byPlayer: 0
    text: And the pool's lovely. Crouch to dive, Jump to come up, and Jump at the
      top to leap right out.
  - byPlayer: 1
    text: Won't the keepers notice there's an extra penguin?
  - byPlayer: 0
    text: Them? They can't tell any of us apart. In here you're just another penguin.
  - byPlayer: 0
    text: Squawk.
