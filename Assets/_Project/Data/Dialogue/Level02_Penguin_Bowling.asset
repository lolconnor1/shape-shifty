  m_Script: {fileID: 11500000, guid: ed6278055cdb5e842a597a9f83d025ef, type: 3}
  m_Name: Level02_Penguin_Bowling
  m_EditorClassIdentifier: 
  lines:
  - byPlayer: 0
    text: Watch this. Up the ramp, belly down, and then... STRIKE!
  - byPlayer: 0
    text: The trick's the ice. Snow grabs your belly, ice doesn't. And the higher
      up you start, the harder you hit.
  - byPlayer: 1
    text: Doesn't that hurt?
  - byPlayer: 0
    text: Only them. Go on, have a go. They love it. Probably.
